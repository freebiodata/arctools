---
import Icon from './Icon.astro';
import { DATA_VERSION, CREATURE_COUNT } from '../data/creatures';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      <h3 class="with-icon"><Icon name="paw-print" size={17} /> ARKTools</h3>
      <p>
        Free taming, breeding, stat projection, and kibble calculators for ARK: Survival Evolved &amp; Ascended.
        Built on extracted game-file constants (v{DATA_VERSION}) with community-verified mechanics formulas.
      </p>
      <p class="fine">
        Not affiliated with or endorsed by Studio Wildcard. ARK: Survival Evolved is
        a trademark of Studio Wildcard, LLC. Fan-made planning utility.
      </p>
    </div>
    <div>
      <h3 class="with-icon"><Icon name="wrench" size={16} /> Tools</h3>
      <ul>
        <li><a href="/taming-calculator/"><Icon name="drumstick" size={14} /> Taming Calculator</a></li>
        <li><a href="/breeding-calculator/"><Icon name="dna" size={14} /> Breeding Calculator</a></li>
        <li><a href="/kibble-chart/"><Icon name="egg" size={14} /> Kibble Chart &amp; Recipes</a></li>
        <li><a href="/stat-calculator/"><Icon name="chart-column" size={14} /> Stat Calculator</a></li>
      </ul>
    </div>
    <div>
      <h3 class="with-icon"><Icon name="book-open" size={16} /> Reference</h3>
      <ul>
        <li><a href="/faq/"><Icon name="circle-help" size={14} /> FAQ</a></li>
        <li><a href="/sources/"><Icon name="scroll-text" size={14} /> Data &amp; Sources</a></li>
        <li><a href="/sitemap-index.xml"><Icon name="map" size={14} /> Sitemap</a></li>
      </ul>
      <p class="fine">{CREATURE_COUNT}-creature verified subset &middot; arctools.top</p>
    </div>
  </div>
  <div style="text-align:center" class="fine">
    &copy; {year} ARKTools &middot; Made for survivors, by survivors.
  </div>
</footer>
