---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const STAT_KEYS = [
  { id: 'hp', label: 'Health' },
  { id: 'stam', label: 'Stamina' },
  { id: 'oxy', label: 'Oxygen' },
  { id: 'food', label: 'Food' },
  { id: 'weight', label: 'Weight' },
  { id: 'melee', label: 'Melee' },
];

const faq = [
  {
    q: 'How do mutations work in ARK: Survival Evolved & Ascended?',
    a: 'Each baby dino gets 3 independent mutation rolls at 2.5% each (a 7.31% chance of at least one mutation when both parents\' counters are under 20). A successful mutation adds +2 wild level points to one of the six mutable stats (Health, Stamina, Oxygen, Food, Weight, Melee) and assigns a random color to one of the creature\'s 6 color regions. The 20/20 rule blocks new mutations from being generated by a parent whose combined matrilineal + patrilineal counter is at 20 or higher—but that parent\'s stats still pass on at standard 55% odds.',
  },
  {
    q: 'What are the odds the baby keeps the higher parent stat?',
    a: '55%. For every individual stat, the offspring independently inherits the higher value with a 55% probability (45% for the lower value; 100% when both parents share identical values). Because the mutated stat must also win this inheritance roll to be kept, a useful mutation on a single desired stat lands on roughly 1 in 150 eggs (0.67%).',
  },
  {
    q: 'How do I bypass the 20/20 mutation cap and stack 40+ mutations?',
    a: 'Use the "Clean Female" breeding strategy: mate your mutated stud male with a flock of unmutated "0/20" females. Even if the father has 100 mutations on his counter (voiding his side of the mutation roll), the mother\'s side remains under 20 and can still trigger new mutations! When a male baby is born with the father\'s existing high stats PLUS a new +2 mutation from the mother, swap him in as the new stud male. Repeat indefinitely.',
  },
  {
    q: 'Why should I breed Health and Melee lines separately?',
    a: 'Hunting for both Health and Melee mutations on the same egg drastically reduces your odds. If you look for a specific mutation on a single stat, your chance is 1 in ~150 eggs. If you demand simultaneous mutations or keep waiting for the "perfect" dual-stat offspring, your odds drop into the thousands. Breed a pure Health line (e.g., 20 HP mutations) and a pure Melee line (e.g., 20 Melee mutations) in parallel, then breed a final HP stud with a final Melee female to combine them in one generation.',
  },
  {
    q: 'What is the negative mutation counter overflow exploit?',
    a: 'ARK stores the mutation counter as a signed 32-bit integer (max value 2,147,483,647). If players bred mutated dinos together indiscriminately, the counter would double every generation until exceeding 2.14 billion and flipping into a negative number (e.g. -2,147,483,648). Because a negative number is mathematically "less than 20," the game engine registers that parent as eligible to generate mutations again. While functional, the clean-female method is simpler, safer, and cleaner.',
  },
  {
    q: 'How many eggs do I need to hatch to get a max-stat combination?',
    a: 'Multiply the independent 55% inheritance chances: for 2 stats, 0.55^2 = 30.2% (~3.3 eggs); for 4 stats, 0.55^4 = 9.15% (~11 eggs); for all 6 stats, 0.55^6 = 2.76% (~36 eggs). To minimize RNG, first create an identical male and female "base pair" where all wild stats match (100% inheritance certainty), then begin your mutation line.',
  },
];

const bossBenchmarks = [
  { boss: 'Alpha Broodmother Lysrix', creature: 'Megatherium (Bug Killer)', targetHp: '25,000 - 30,000 HP', targetMelee: '700% - 900% Melee', strategy: 'Bug Killer buff grants 250% damage dealt and 75% damage reduction upon killing any Araneo spider.' },
  { boss: 'Alpha Megapithecus (Gorilla)', creature: 'Tyrannosaurus Rex', targetHp: '30,000 - 35,000 HP', targetMelee: '800% - 1,000% Melee', strategy: 'Fast burst DPS. Megapithecus hits hard with rock throws but possesses lower total health pool.' },
  { boss: 'Alpha Dragon', creature: 'Therizinosaurus', targetHp: '21,000 HP (Exact)', targetMelee: '1,000%+ Melee', strategy: 'Dragon\'s breath deals 20% max HP over 10s. Herbivores eat Sweet Veggie Cakes (+2,100 HP per cake); keeping HP around 21k maximizes cake healing efficiency.' },
  { boss: 'Alpha Overseer (Tek Cave)', creature: 'Rex / Therizino + Yuty', targetHp: '30,000 HP', targetMelee: '900%+ Melee', strategy: 'Yutyrannus courage roar (+25% damage, +20% damage resistance) is mandatory across all phases.' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'ARK Breeding Calculator',
    applicationCategory: 'GameApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description:
      'ARK: Survival Evolved & Ascended breeding calculator: stat inheritance probability (55/45 model), mutation chances, 20/20 cap bypass, and expected eggs for max-stat offspring.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout
  title="ARK Breeding Calculator - Stat Inheritance & Mutation Chances"
  description="ARK breeding calculator: enter both parents' stat levels and get the exact probability of a max-stat baby - 55%/45% stat inheritance, mutation odds with the 20/20 rule, expected eggs, and baby wild level."
  path="/breeding-calculator/"
  schema={schema}
>
  <section class="page-head">
    <span class="eyebrow"><Icon name="dna" size={15} /> Tool 02 - The Punnett Square, ARK Edition</span>
    <h1>ARK Breeding Calculator</h1>
    <p class="lead">
      ARK calculates each stat independently upon fertilization: the baby takes the higher parent stat
      with <strong>55%</strong> probability, and the lower with 45%. Input your breeding pair below to
      calculate exact max-stat offspring odds, mutation roll probabilities, and expected egg counts.
    </p>
    <div class="tag-row">
      <span class="badge">55/45 Inheritance Model</span>
      <span class="badge">3 &times; 2.5% Mutation Rolls</span>
      <span class="badge">20/20 Cap Aware</span>
      <span class="badge">Clean Female Logic</span>
    </div>
  </section>

  <div class="grid-2">
    <form class="panel" id="breed-form" aria-label="Breeding calculator inputs">
      <h2 class="with-icon" style="font-size:1.35rem"><Icon name="heart-handshake" size={20} /> Parent Stat Points</h2>
      <div class="table-wrap">
        <table class="data" id="breed-table">
          <thead>
            <tr><th>Stat</th><th class="num">Mother</th><th class="num">Father</th><th class="num">Target ≥</th></tr>
          </thead>
          <tbody>
            {STAT_KEYS.map((s) => (
              <tr>
                <td>{s.label}</td>
                <td class="num"><input type="number" min="0" max="255" value={s.id === 'hp' ? '40' : '0'} data-row={s.id} data-col="a" style="width:90px" aria-label={`${s.label} mother points`} /></td>
                <td class="num"><input type="number" min="0" max="255" value={s.id === 'hp' ? '20' : '0'} data-row={s.id} data-col="b" style="width:90px" aria-label={`${s.label} father points`} /></td>
                <td class="num"><input type="number" min="0" max="255" value={s.id === 'hp' ? '40' : '0'} data-row={s.id} data-col="t" style="width:90px" aria-label={`${s.label} target points`} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted" style="font-size:.85rem">
        Values are <strong>wild stat points</strong> (what a stat tool or incubator shows),
        not displayed percentage or absolute values. A fresh 150-tame distributes ~149 points across these six stats.
      </p>

      <h2 class="with-icon" style="font-size:1.15rem;margin-top:1.25rem"><Icon name="dices" size={18} /> Mutation Counters</h2>
      <div class="stat-grid" style="grid-template-columns:1fr 1fr">
        <div class="field">
          <label for="breed-mut-m">Mother (Matrilineal)</label>
          <input type="number" id="breed-mut-m" min="0" value="0" />
        </div>
        <div class="field">
          <label for="breed-mut-f">Father (Patrilineal)</label>
          <input type="number" id="breed-mut-f" min="0" value="0" />
        </div>
      </div>

      <div class="field">
        <label for="breed-mut-stats">Desired Tracked Stats for Useful Mutation</label>
        <select id="breed-mut-stats">
          <option value="1">1 stat (e.g. Melee only)</option>
          <option value="2">2 stats (e.g. Health OR Melee)</option>
          <option value="3">3 stats (Health, Stamina or Melee)</option>
        </select>
        <p class="muted" style="font-size:.82rem;margin:.3rem 0 0">
          Most breeders track 1 stat at a time (e.g., pure Melee line) to maximize efficiency.
        </p>
      </div>
    </form>

    <div class="results" aria-live="polite">
      <section class="panel" aria-label="Breeding odds summary">
        <h2 class="with-icon" style="font-size:1.35rem"><Icon name="sparkles" size={20} /> Offspring Probabilities</h2>
        <div class="stat-grid">
          <div class="stat"><span class="stat__label"><Icon name="dice-5" size={13} /> Chance of target stats</span><span class="stat__value" id="br-prob">–</span><span class="stat__sub" id="br-prob-sub"></span></div>
          <div class="stat"><span class="stat__label"><Icon name="egg" size={13} /> Expected eggs needed</span><span class="stat__value" id="br-eggs">–</span><span class="stat__sub">average hatches to hit target</span></div>
          <div class="stat"><span class="stat__label"><Icon name="dna" size={13} /> Any mutation chance</span><span class="stat__value" id="br-mutany">–</span><span class="stat__sub" id="br-mutany-sub"></span></div>
          <div class="stat"><span class="stat__label"><Icon name="target" size={13} /> Useful mutation chance</span><span class="stat__value" id="br-mutuse">–</span><span class="stat__sub" id="br-mutuse-sub"></span></div>
        </div>

        <div class="table-wrap" style="margin-top:1rem">
          <table class="data" id="br-perstat">
            <thead>
              <tr><th>Stat</th><th class="num">Mother</th><th class="num">Father</th><th class="num">Target</th><th class="num">Chance</th></tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>

        <div class="stat-grid" style="margin-top:1rem">
          <div class="stat"><span class="stat__label"><Icon name="trending-up" size={13} /> Best-case baby level</span><span class="stat__value" id="br-level">–</span><span class="stat__sub">taking the higher stat each roll</span></div>
          <div class="stat"><span class="stat__label"><Icon name="trending-down" size={13} /> Worst-case baby level</span><span class="stat__value" id="br-level-worst">–</span><span class="stat__sub">taking the lower stat each roll</span></div>
          <div class="stat"><span class="stat__label"><Icon name="dices" size={13} /> Mutation levels</span><span class="stat__value">+2 / mutation</span><span class="stat__sub">on one random mutable stat</span></div>
        </div>
        <div class="callout" style="margin-top:1rem">
          <strong>Rule of thumb:</strong> each additional stat you demand from the
          stronger parent divides your odds by ~1.8 (&times;0.55). Two stats &approx; 30%,
          three &approx; 17%, six &approx; 2.8%. Establish clean baseline parents first, then isolate mutations.
        </div>
      </section>
    </div>
  </div>

  <!-- Mutation Stacking Blueprint -->
  <section class="panel" style="margin-top: 2rem" aria-label="Mutation Line Stacking Blueprint">
    <h2 class="with-icon"><Icon name="git-branch" size={22} /> Master Blueprint: Stacking 20+ Mutations (The Clean Female System)</h2>
    <div class="prose">
      <p>
        The 20/20 mutation cap stops a creature from producing new mutations once its counter reaches 20.
        However, the game checks <em>each parent separately</em> during the 3 mutation rolls.
        By exploiting this rule, you can stack 50, 100, or 200 mutations into a single stat line:
      </p>
      <ol>
        <li>
          <strong>Step 1 — Establish a Clean Base Pair:</strong> Breed wild tames until you obtain a male and female with identical top stats and <strong>0/0 mutations</strong> on both sides.
        </li>
        <li>
          <strong>Step 2 — Mass Produce Clean Females:</strong> Breed that base pair to hatch 20 to 50 identical unmutated females (0/0 mutations).
          These females will serve as your permanent breeding flock and will never be swapped out.
        </li>
        <li>
          <strong>Step 3 — Roll for Male Mutation:</strong> Mate your base male with all 50 clean females.
          Hatch the eggs until you get a <strong>male baby</strong> with a +2 mutation in your target stat (e.g., Melee: 42 &rarr; 44 points).
        </li>
        <li>
          <strong>Step 4 — Swap the Stud Male:</strong> Replace the old father with the new mutant son.
          His mutation counter will show 1/20 (or 0/1). Breed him with the exact same 50 clean females.
        </li>
        <li>
          <strong>Step 5 — Bypassing the 20/20 Cap:</strong> When the stud male eventually reaches 20/20 mutations, <em>his side of the mutation roll turns off</em>.
          However, because all 50 mothers remain at 0/20, rolls assigned to the mothers still succeed!
          The baby can inherit the father's massive stats (55% chance) and receive a fresh +2 mutation from the mother.
        </li>
      </ol>
      <div class="callout">
        <strong>Critical Warning:</strong> Never use a mutated female to breed your next generation stud.
        If a mutation lands on a female baby, mate her once to a clean 0/0 male until she produces a son carrying the mutated stat, then use that son with your clean female flock.
      </div>
    </div>
  </section>

  <!-- Boss Prep Stat Benchmarks -->
  <section class="panel" style="margin-top: 2rem" aria-label="Boss Stat Benchmarks">
    <h2 class="with-icon"><Icon name="trophy" size={22} /> Island Alpha Boss Breeding Benchmarks</h2>
    <p>
      Baseline target stats required upon hatch (pre-leveling) and after domestic points + 100% imprint to reliably defeat The Island's Alpha Bosses on Official Server settings:
    </p>
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr>
            <th>Boss Arena</th>
            <th>Primary Dino Meta</th>
            <th>Target Health Pool</th>
            <th>Target Melee Damage</th>
            <th>Tactical Strategy &amp; Mechanics</th>
          </tr>
        </thead>
        <tbody>
          {bossBenchmarks.map((b) => (
            <tr>
              <td><strong>{b.boss}</strong></td>
              <td><span class="badge">{b.creature}</span></td>
              <td class="num">{b.targetHp}</td>
              <td class="num">{b.targetMelee}</td>
              <td style="white-space: normal">{b.strategy}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="prose" style="margin-top:2.5rem">
    <h2>The Documented Inheritance &amp; Mutation Model</h2>
    <p>
      When an egg hatches, ARK builds the baby stat-by-stat: for each of the six
      stats it compares both parents and gives the baby the higher value with 55%
      probability (45% the lower; certain when equal). Wild points and mutation
      points inherit together—the baby's wild level is 1 plus the points it took.
    </p>
    <p>
      After inheritance, up to three mutation rolls occur. Each roll first selects a
      random parent; if that parent's combined mutation counter is 20 or higher the
      roll is skipped (the 20/20 rule), otherwise it succeeds with 2.5%. A success adds
      +2 wild levels to one of the six mutable stats and rerolls one color region.
      Speed can never mutate. With both parents clean, at least one mutation lands
      with 1 &minus; 0.975&sup3; = <strong>7.31%</strong> probability; with one parent blocked it
      roughly halves to &approx; 3.7%; with both blocked it is zero.
    </p>
    <p>
      A fresh mutation is only useful if the baby also inherits the mutated stat—the
      same 55% inheritance bias—so a mutation landing on your single tracked
      stat survives at 7.31% &times; (1/6) &times; 0.55 &approx; <strong>0.67%</strong>, or about
      1 in 150 eggs. This is exactly the "useful mutation" metric computed above.
    </p>
  </section>

  <section style="margin-top:2.5rem" aria-label="FAQ">
    <h2>Breeding FAQ</h2>
    {faq.map((f) => (
      <details class="faq">
        <summary>{f.q}</summary>
        <div class="faq-body"><p>{f.a}</p></div>
      </details>
    ))}
  </section>

  <script>
    import {
      babyStatProbability,
      babyWildLevel,
      mutationChances,
      usefulMutationChance,
    } from '../lib/breeding';

    const el = <T extends HTMLElement>(id: string): T => document.getElementById(id) as T;
    const STAT_KEYS = ['hp', 'stam', 'oxy', 'food', 'weight', 'melee'];
    const STAT_LABEL: Record<string, string> = {
      hp: 'Health', stam: 'Stamina', oxy: 'Oxygen',
      food: 'Food', weight: 'Weight', melee: 'Melee',
    };

    function readInputs() {
      const rows = STAT_KEYS.map((id) => {
        const a = Number((document.querySelector(`[data-row="${id}"][data-col="a"]`) as HTMLInputElement).value) || 0;
        const b = Number((document.querySelector(`[data-row="${id}"][data-col="b"]`) as HTMLInputElement).value) || 0;
        const t = Number((document.querySelector(`[data-row="${id}"][data-col="t"]`) as HTMLInputElement).value) || 0;
        return { key: id, stat: STAT_LABEL[id], levelA: a, levelB: b, target: t };
      });
      const mother = Number(el<HTMLInputElement>('breed-mut-m').value) || 0;
      const father = Number(el<HTMLInputElement>('breed-mut-f').value) || 0;
      const wanted = Number(el<HTMLSelectElement>('breed-mut-stats').value) || 1;
      return { rows, mother, father, wanted };
    }

    function pct(p: number, digits = 2): string {
      return (p * 100).toFixed(digits) + '%';
    }

    function render() {
      const { rows, mother, father, wanted } = readInputs();

      const targets: Record<string, number> = {};
      for (const r of rows) targets[r.stat] = r.target;

      const out = babyStatProbability(
        rows.map((r) => ({ stat: r.stat, levelA: r.levelA, levelB: r.levelB })),
        targets,
      );
      el('br-prob').textContent = out.probability > 0 ? pct(out.probability) : '0%';
      el('br-prob-sub').textContent = out.probability > 0 ? 'per egg (or live birth)' : 'impossible - raise a target\u2019s parents';
      el('br-eggs').textContent = out.probability > 0
        ? '1 in ' + Math.round(1 / out.probability).toLocaleString('en-US')
        : '∞';

      const tbody = el('br-perstat').querySelector('tbody')!;
      tbody.innerHTML = rows.map((r) => {
        const row = out.perStat.find((p) => p.stat === r.stat)!;
        const chance = row.chance === 1 ? 'certain' : row.chance === 0 ? 'impossible*' : pct(row.chance, 1);
        const cls = row.chance === 1 ? '' : row.chance === 0 ? 'style="color:var(--danger)"' : '';
        return `<tr ${cls}><td>${r.stat}</td><td class="num">${r.levelA}</td><td class="num">${r.levelB}</td><td class="num">${r.target}</td><td class="num">${chance}</td></tr>`;
      }).join('');

      const best = rows.map((r) => Math.max(r.levelA, r.levelB));
      const worst = rows.map((r) => Math.min(r.levelA, r.levelB));
      el('br-level').textContent = String(babyWildLevel(best));
      el('br-level-worst').textContent = String(babyWildLevel(worst));

      const mut = mutationChances(mother, father);
      el('br-mutany').textContent = mut.atLeastOne > 0 ? pct(mut.atLeastOne) : '0%';
      el('br-mutany-sub').textContent = mother >= 20 && father >= 20
        ? 'both counters ≥ 20 (20/20 rule)'
        : `${mut.atLeastOne > 0 ? '1−0.975³ or 1−0.9875³' : ''}`;
      const use = usefulMutationChance(wanted, mother, father);
      el('br-mutuse').textContent = use.chance > 0 ? pct(use.chance) : '0%';
      el('br-mutuse-sub').textContent = use.chance > 0
        ? `1 in ${Math.round(1 / use.chance)} eggs for ${wanted} tracked stat${wanted > 1 ? 's' : ''}`
        : 'counters exhausted';
    }

    document.querySelectorAll('#breed-table input').forEach((i) =>
      i.addEventListener('input', render),
    );
    el('breed-mut-m').addEventListener('input', render);
    el('breed-mut-f').addEventListener('input', render);
    el('breed-mut-stats').addEventListener('change', render);
    render();
  </script>
</BaseLayout>
