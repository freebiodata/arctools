---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { creatures } from '../data/creatures';
import { STAT_NAMES } from '../data/types';
import type { StatIndex } from '../data/types';

const STAT_COLS: StatIndex[] = [0, 1, 3, 4, 7, 8];
const nice: Record<number, string> = {
  0: 'Health', 1: 'Stamina', 3: 'Oxygen', 4: 'Food', 7: 'Weight', 8: 'Melee %',
};

const faq = [
  {
    q: 'How do bonus levels from taming work?',
    a: 'When the tame finishes you gain bonus levels = floor(wild level × taming effectiveness / 2), distributed randomly across the stats. A 150 at 98.7% TE gets +74 levels; a perfect 100% TE tame would get +75 (level 225). Those bonus levels are random per stat - that\u2019s why two identical tames can end up with different stats.',
  },
  {
    q: 'What does imprinting actually change?',
    a: 'At 100% imprint the creature gets +20% on Health, Food, Weight, Melee (and Torpor/Water - invisible in practice) but NOT Stamina, Oxygen or Crafting, and flyers get no speed bonus. On top, the imprinter riding it gets ×1.3 damage dealt and takes only 70% damage while ridden. Partial imprints scale linearly (50% imprint = +10% stats).',
  },
  {
    q: 'Why did my tamed creature lose melee after imprint?',
    a: 'It didn\u2019t - the taming effectiveness multiplier already applies at tame time: melee shows (base + 50% tame bonus) × (1 + 0.4 × TE). A low-TE tame visibly "loses" melee versus the wild value, and imprinting adds its 20% on top of the tamed number, never the wild one.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'ARK Stat Calculator',
    applicationCategory: 'GameApplication',
    operatingSystem: 'Web',
    description:
      'ARK stat calculator: project wild vs tamed vs imprinted stat values with taming effectiveness, imprinting bonus and domestic level-ups.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout
  title="ARK Stat Calculator - Wild vs Tamed vs Imprinted"
  description="ARK stat point calculator: see exactly how wild points, taming effectiveness, imprinting (+20%) and domestic levels combine into final stats for 60+ creatures before you tame or level anything."
  path="/stat-calculator"
  schema={schema}
>
  <section class="page-head">
    <span class="eyebrow"><Icon name="chart-column" size={15} /> Tool 04 - point accounting</span>
    <h1>ARK Stat Calculator</h1>
    <p class="lead">
      ARK computes stats in three layers - wild points, taming bonuses, then
      imprinting and domestic levels. Set your scenario below and see the exact
      final numbers the game will show, stat by stat.
    </p>
    <div class="tag-row">
      <span class="badge">Game formula, exact constants</span>
      <span class="badge">Imprint +20% where it applies</span>
      <span class="badge">Rider bonus included</span>
    </div>
  </section>

  <div class="grid-2">
    <form class="panel" id="stat-form" aria-label="Stat calculator inputs">
      <h2 class="with-icon" style="font-size:1.35rem"><Icon name="sliders-horizontal" size={20} /> Scenario</h2>

      <div class="field">
        <label for="sc-creature">Creature</label>
        <select id="sc-creature">
          {creatures.filter((c) => c.stats[0]).map((c) => (
            <option value={c.slug} selected={c.slug === 'rex'}>{c.name}</option>
          ))}
        </select>
      </div>

      <div class="field">
        <label for="sc-te">Taming effectiveness <span class="hint">(kibble ≈ 99%, meat ≈ 30–60%)</span></label>
        <input type="range" id="sc-te" min="0" max="100" value="99" step="1" />
        <div style="display:flex;justify-content:space-between"><span class="muted" style="font-size:.85rem" id="sc-te-label">99%</span><span class="muted" style="font-size:.85rem" id="sc-bonus-label">+74 bonus levels</span></div>
      </div>

      <div class="field">
        <label for="sc-imprint">Imprinting <span class="hint">(0–100%)</span></label>
        <input type="range" id="sc-imprint" min="0" max="100" value="100" step="1" />
        <div style="display:flex;justify-content:space-between"><span class="muted" style="font-size:.85rem" id="sc-imprint-label">100%</span><span class="muted" style="font-size:.85rem">rider bonus ×1.3 dmg / ×0.7 taken</span></div>
      </div>

      <h2 style="font-size:1.2rem;margin-top:1.3rem">Wild points <span class="muted" style="text-transform:none;font-family:var(--font-body);font-size:.8rem;font-weight:400">(as tamed / after tame roll)</span></h2>
      <div class="table-wrap">
        <table class="data">
          <thead><tr><th>Stat</th><th class="num">Wild pts</th><th class="num">Domestic pts</th></tr></thead>
          <tbody>
            {STAT_COLS.map((si) => (
              <tr>
                <td>{nice[si]}</td>
                <td class="num"><input type="number" min="0" max="255" value={si === 0 ? '30' : '0'} data-stat={si} data-kind="wild" style="width:90px" aria-label={`${nice[si]} wild points`} /></td>
                <td class="num"><input type="number" min="0" max="255" value="0" data-stat={si} data-kind="dom" style="width:90px" aria-label={`${nice[si]} domestic points`} /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted" style="font-size:.85rem" id="sc-level-note"></p>
    </form>

    <div>
      <section class="panel" aria-label="Stat projection">
        <h2 class="with-icon" style="font-size:1.35rem"><Icon name="table-2" size={20} /> Projection</h2>
        <div class="table-wrap">
          <table class="data" id="sc-table">
            <thead>
              <tr>
                <th>Stat</th><th class="num">Wild value</th><th class="num">After tame</th>
                <th class="num">Imprinted</th><th class="num">Fully leveled</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
        <div class="stat-grid" style="margin-top:1rem">
          <div class="stat"><span class="stat__label"><Icon name="paw-print" size={13} /> Wild level</span><span class="stat__value" id="sc-wild-level">–</span><span class="stat__sub">1 + wild points</span></div>
          <div class="stat"><span class="stat__label"><Icon name="trending-up" size={13} /> Level after tame</span><span class="stat__value" id="sc-tame-level">–</span><span class="stat__sub" id="sc-tame-level-sub"></span></div>
          <div class="stat"><span class="stat__label"><Icon name="swords" size={13} /> Rider damage</span><span class="stat__value" id="sc-rider">–</span><span class="stat__sub">with imprint rider bonus</span></div>
        </div>
      </section>

      <section class="panel" aria-label="Formula">
        <h2 class="with-icon" style="font-size:1.2rem"><Icon name="sigma" size={18} /> The formula it runs</h2>
        <p style="font-size:.95rem;color:var(--bone-200)">
          <code>(Base × (1 + wild×IncWild + mut×IncWild) × TBHPM × imprintM + AddWhenTamed) × (1 + MultAffinity × TE) × (1 + dom×IncDom)</code>
        </p>
        <p class="muted" style="font-size:.9rem">
          <strong>imprintM</strong> is 1.2 × imprint% on Health/Food/Weight/Melee
          (and Torpor/Water), 1.0 on Stamina/Oxygen/Crafting; flyers also skip it
          for Speed. <strong>TE</strong> only scales stats with a MultAffinity bonus
          (melee and a few others - for Rex that's ×(1+0.4·TE)). Bonus levels from
          taming are excluded from the projection because the game rolls them
          randomly - the "level after tame" figure shows how many you gained.
        </p>
      </section>
    </div>
  </div>

  <section class="prose" style="margin-top:2.5rem">
    <h2>Wild vs tamed vs imprinted - the three layers</h2>
    <p>
      <strong>Wild:</strong> a wild creature's stat is simply
      <code>Base × (1 + points × IncWild)</code>. Its level is 1 plus all points
      across the six mutable stats (Torpor scales with level but is not a point stat).
    </p>
    <p>
      <strong>Tamed:</strong> the moment the tame finishes, two things happen: bonus
      levels (from taming effectiveness) are rolled randomly into the stats, and
      species bonuses apply - an additive bonus (e.g. +50% melee for most carnivores)
      and a TE-scaled multiplicative bonus. This is why a freshly tamed Rex shows
      ~209% melee even with zero points in it.
    </p>
    <p>
      <strong>Imprinted &amp; leveled:</strong> imprinting multiplies the tamed value
      by up to ×1.2 on the affected stats, and each domestic point adds
      <code>IncDom × current base</code> - for HP that's +27% of the tamed base per
      point on a Rex. Because domestic points scale off the already-bonused value,
      imprint first, level second: same points, bigger gains.
    </p>
  </section>

  <section style="margin-top:2.5rem" aria-label="FAQ">
    <h2>Stats FAQ</h2>
    {faq.map((f) => (
      <details class="faq">
        <summary>{f.q}</summary>
        <div class="faq-body"><p>{f.a}</p></div>
      </details>
    ))}
  </section>

  <script>
    import { creatures } from '../data/creatures';
    import {
      projectStat,
      wildStatValue,
      bonusLevels,
      riderDamageMultiplier,
      wildLevelFromPoints,
    } from '../lib/stats';
    import type { Creature, StatIndex } from '../data/types';

    const el = <T extends HTMLElement>(id: string): T => document.getElementById(id) as T;
    const pool = creatures.filter((c) => c.stats[0]);
    const bySlug = new Map(pool.map((c) => [c.slug, c]));
    const STAT_COLS: StatIndex[] = [0, 1, 3, 4, 7, 8];
    const NICE: Record<number, string> = {
      0: 'Health', 1: 'Stamina', 3: 'Oxygen', 4: 'Food', 7: 'Weight', 8: 'Melee %',
    };

    const fmt = (v: number, si: StatIndex): string => {
      if (si === 8) return (v * 100).toFixed(1) + '%';
      return Math.round(v).toLocaleString('en-US');
    };

    function read(): { c: Creature; te: number; imprint: number; wild: Map<StatIndex, number>; dom: Map<StatIndex, number> } {
      const wild = new Map(), dom = new Map();
      for (const si of STAT_COLS) {
        wild.set(si, Number((document.querySelector(`[data-stat="${si}"][data-kind="wild"]`) as HTMLInputElement).value) || 0);
        dom.set(si, Number((document.querySelector(`[data-stat="${si}"][data-kind="dom"]`) as HTMLInputElement).value) || 0);
      }
      return {
        c: bySlug.get(el<HTMLSelectElement>('sc-creature').value)!,
        te: Number(el<HTMLInputElement>('sc-te').value) / 100,
        imprint: Number(el<HTMLInputElement>('sc-imprint').value) / 100,
        wild, dom,
      };
    }

    function render() {
      const { c, te, imprint, wild, dom } = read();
      el('sc-te-label').textContent = (te * 100).toFixed(0) + '%';
      const bonus = bonusLevels(150, te);
      el('sc-bonus-label').textContent = `+${bonus} bonus levels (on a 150)`;
      el('sc-imprint-label').textContent = (imprint * 100).toFixed(0) + '%';

      const tbody = el('sc-table').querySelector('tbody')!;
      tbody.innerHTML = STAT_COLS.filter((si) => c.stats[si]).map((si) => {
        const w = wild.get(si)!, d = dom.get(si)!;
        const raw = c.stats[si]!;
        const wildV = wildStatValue(raw, w);
        const tamedV = projectStat(c, si, { wildPoints: w, tamingEffectiveness: te });
        const impV = projectStat(c, si, { wildPoints: w, tamingEffectiveness: te, imprintFraction: imprint });
        const fullV = projectStat(c, si, { wildPoints: w, tamingEffectiveness: te, imprintFraction: imprint, domPoints: d });
        return `<tr><td>${NICE[si]}</td><td class="num">${fmt(wildV, si)}</td><td class="num">${fmt(tamedV, si)}</td><td class="num">${fmt(impV, si)}</td><td class="num"><strong style="color:var(--amber-300)">${fmt(fullV, si)}</strong></td></tr>`;
      }).join('');

      const pts: Record<string, number> = {};
      STAT_COLS.forEach((si) => (pts[String(si)] = wild.get(si)!));
      const wl = wildLevelFromPoints(pts);
      el('sc-wild-level').textContent = String(wl);
      const bl = bonusLevels(wl, te);
      el('sc-tame-level').textContent = String(wl + bl);
      el('sc-tame-level-sub').textContent = `+${bl} bonus at ${(te * 100).toFixed(0)}% TE · max ${wl + Math.floor(wl / 2)} at 100%`;
      el('sc-rider').textContent = '×' + riderDamageMultiplier(imprint).toFixed(2);

      const melee = wild.get(8)!;
      el('sc-level-note').textContent =
        `Wild points are what the creature spawns/tames with. Bonus levels from taming (+${bl} here) land randomly - reroll luck applies per stat.` +
        (melee > 0 ? '' : '');
    }

    el('sc-creature').addEventListener('change', render);
    el('sc-te').addEventListener('input', render);
    el('sc-imprint').addEventListener('input', render);
    document.querySelectorAll('#stat-form input[type="number"]').forEach((i) =>
      i.addEventListener('input', render),
    );
    render();
  </script>
</BaseLayout>
