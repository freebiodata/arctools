---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { kibbleRecipes } from '../data/kibble';
import { EGG_LAYERS } from '../data/eggs';
import { creatures } from '../data/creatures';

const preferers = creatures
  .filter((c) => c.preferredKibble)
  .map((c) => ({
    name: c.name,
    slug: c.slug,
    method: c.tameMethod,
    tier: c.preferredKibble!,
    role: c.role,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const byTier = (tier: string) => preferers.filter((p) => p.tier === tier);

const faq = [
  {
    q: 'Which kibble tier should I use for my target creature?',
    a: 'Always use the exact tier preferred by the creature (or any higher tier). Preferred kibble provides 400 taming affinity per bite. Using a higher tier works identically at full 400 affinity. However, using any lower tier drops affinity to a punitive 16 affinity per piece—worse than raw standard meat! Check the reverse lookup table below to find your creature\'s tier.',
  },
  {
    q: 'Why did my Cooking Pot produce Dye instead of Kibble?',
    a: 'Wood burns into Charcoal in a Cooking Pot. When berries, water, and charcoal combine in the pot, the recipe engine crafts Dye instead of Kibble! To prevent accidental dye production, always fuel your Cooking Pot with Thatch or Sparkpowder (neither produces charcoal), or cook kibble in an Industrial Cooker.',
  },
  {
    q: 'Can I use fertilized eggs or Wyvern/Deinonychus eggs for kibble?',
    a: 'Yes! The recipe system treats fertilized and unfertilized eggs identically; only the egg size category matters. High-spoilage fertilized eggs or unhatched rejects from breeding lines can be cooked into kibble without penalty. For Extraordinary Kibble, wild Yutyrannus, Wyvern, Magmasaur, Rock Drake, or Deinonychus eggs all satisfy the Special Egg requirement.',
  },
  {
    q: 'How does an Oviraptor boost egg production in a base?',
    a: 'Setting an Oviraptor on "Wander" grants an egg-laying buff (indicated by a small egg icon above nearby dinos) to all tamed female creatures in its radius. This reduces the egg-laying interval from ~17 minutes to ~11 minutes. To keep the Oviraptor in place without building cages, fill its inventory with heavy stone so it cannot physically move while wandering.',
  },
  {
    q: 'How do I supply water to an Industrial Cooker vs Cooking Pot?',
    a: 'A Cooking Pot requires a Waterskin, Water Jar, or Canteen that is at least 25% full placed manually into its inventory (consumed during craft). An Industrial Cooker must be snapped directly to an irrigated water pipe; as long as the pipe network has water access (via intake or water reservoir), the cooker automatically supplies infinite water for continuous batch crafting.',
  },
];

const cookerComparison = [
  { feature: 'Crafting Speed', pot: '30.0 seconds / kibble', cooker: '3.0 seconds / kibble (10x faster)' },
  { feature: 'Water Supply', pot: 'Manual Waterskins / Canteens (Refill needed)', cooker: 'Direct pipe irrigation (Infinite auto-supply)' },
  { feature: 'Fuel Type', pot: 'Thatch or Sparkpowder (Avoid Wood)', cooker: 'Gasoline or Electricity' },
  { feature: 'Inventory Slots', pot: '12 Slots', cooker: '100 Slots (Mass batch crafting)' },
  { feature: 'Dye Conflict Risk', pot: 'High (Charcoal from wood triggers dye)', cooker: 'Zero (Gasoline creates no charcoal)' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'ARK Kibble Chart',
    applicationCategory: 'GameApplication',
    operatingSystem: 'Web',
    description:
      'ARK kibble chart: all six kibble recipes (Basic to Extraordinary), egg size tiers, egg farm setups, and creature preferences.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout
  title="ARK Kibble Chart - All Recipes, Egg Sizes & Preferences"
  description="Complete ARK kibble chart: exact recipes for Basic, Simple, Regular, Superior, Exceptional and Extraordinary kibble, which egg sizes and creatures produce each tier, and which kibble every popular creature prefers."
  path="/kibble-chart/"
  schema={schema}
>
  <section class="page-head">
    <span class="eyebrow"><Icon name="egg" size={15} /> Tool 03 - The Kitchen Wall Chart</span>
    <h1>ARK Kibble Chart &amp; Recipes</h1>
    <p class="lead">
      Six quality tiers, six recipes, zero guesswork. Under ARK's Homestead system, every egg maps to a size class,
      and every creature prefers a specific kibble tier (higher tiers also work at full value; lower tiers yield only 16 affinity).
    </p>
    <div class="tag-row">
      <span class="badge">Homestead 6-Tier System</span>
      <span class="badge">Cooking Pot &middot; 30s per Kibble</span>
      <span class="badge">Industrial Cooker &middot; 3s per Kibble</span>
      <span class="badge">Automated Farm Blueprints</span>
    </div>
  </section>

  <div class="cards" id="kibble-cards">
    {kibbleRecipes.map((k) => (
      <section class="card" style="cursor:default">
        <h2><Icon name="egg" size={20} /> {k.tier} Kibble</h2>
        <p style="margin-bottom:.6rem"><span class="badge">{k.eggSize}</span></p>
        <ul style="list-style:none;padding:0;margin:0 0 .7rem;font-size:.95rem;color:var(--bone-200)">
          {k.recipe.filter((r) => r.ingredient !== 'Water').map((r) => (
            <li style="display:flex;justify-content:space-between;gap:.5rem;border-bottom:1px dashed rgba(245,240,230,.12);padding:.18rem 0">
              <span>{r.ingredient}</span><strong style="color:var(--amber-300)">×{r.qty}</strong>
            </li>
          ))}
          <li style="display:flex;justify-content:space-between;gap:.5rem;padding-top:.18rem">
            <span>Water (any container ≥25%)</span><strong style="color:var(--amber-300)">1</strong>
          </li>
        </ul>
        <p class="muted" style="font-size:.85rem">{k.note}</p>
      </section>
    ))}
  </div>

  <section class="panel" style="margin-top:1.5rem">
    <h2 class="with-icon"><Icon name="boxes" size={20} /> Which Creatures Lay Which Eggs <span class="muted" style="text-transform:none;font-family:var(--font-body);font-size:.85rem;font-weight:400">(Kibble Ingredients)</span></h2>
    {Object.entries(EGG_LAYERS).map(([tier, layers]) => (
      <div style="margin-bottom:.8rem">
        <strong style="color:var(--amber-400)">{tier}:</strong>{' '}
        <span style="color:var(--bone-200)">{layers.join(', ')}</span>
      </div>
    ))}
    <p class="muted" style="font-size:.85rem">
      Mammals (Mammoth, Anky-adjacent glyptodonts like Doedicurus, Equus, Rhinos,
      Bears, Paracers…) give live birth and never lay eggs. Insects and some
      others lay eggs that cannot be used for kibble.
    </p>
  </section>

  <!-- Reverse Lookup Search -->
  <section class="panel" style="margin-top:1.5rem" aria-label="Creature preference lookup">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.8rem">
      <h2 class="with-icon" style="font-size:1.35rem;margin:0"><Icon name="search" size={20} /> Creature Kibble Preferences</h2>
      <input type="text" id="kb-search" placeholder="Filter by creature name..." style="max-width:260px" aria-label="Filter creatures" />
    </div>
    <div class="table-wrap" style="margin-top:1rem">
      <table class="data" id="kb-table">
        <thead>
          <tr><th>Creature</th><th>Preferred kibble</th><th>Method</th><th>Role</th></tr>
        </thead>
        <tbody>
          {preferers.map((p) => (
            <tr data-name={p.name.toLowerCase()}>
              <td><strong>{p.name}</strong></td>
              <td><span class="badge">{p.tier} Kibble</span></td>
              <td><span class={`badge badge--${p.method}`}>{p.method}</span></td>
              <td style="white-space:normal">{p.role}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="muted" style="font-size:.85rem;margin-top:.6rem">
      Preferers by tier:
      {kibbleRecipes.map((k) => ` ${k.tier}: ${byTier(k.tier).length} ·`)}
      Full coverage of verified subset. Special tames (Wyvern, Rock Drake, Reaper, Titanosaur, Carcharodontosaurus) do not use standard kibble.
    </p>
  </section>

  <!-- Automated Egg Farm Blueprint -->
  <section class="panel" style="margin-top:2.5rem">
    <h2 class="with-icon"><Icon name="cpu" size={22} /> Automated Egg Farm &amp; Greenhouse Setup</h2>
    <div class="prose">
      <p>
        Building a reliable kibble kitchen requires two automated production pipelines: an egg-laying dino barn and an irrigated greenhouse crop farm.
      </p>
      <h3>1. The Oviraptor-Boosted Egg Barn</h3>
      <ul>
        <li><strong>Breeding Ratio:</strong> Keep 1 male dino for every 4 to 6 female dinos. Female dinos gain a <strong>Mate-Boosted</strong> buff that doubles egg drop frequency.</li>
        <li><strong>The Oviraptor Totem:</strong> Tame an Oviraptor and place it in the center of your female dinos. Enable <strong>Wander</strong>. Overload its inventory with heavy stone so it remains anchored in place while permanently providing the egg icon buff. This lowers laying cooldowns to ~11 minutes.</li>
        <li><strong>Recommended Egg Producers:</strong>
          <ul>
            <li><strong>Basic:</strong> Dodo (instant tames, lay eggs constantly).</li>
            <li><strong>Simple:</strong> Raptor or Microraptor.</li>
            <li><strong>Regular:</strong> Ankylosaurus or Stegosaurus.</li>
            <li><strong>Superior:</strong> Argentavis or Carno.</li>
            <li><strong>Exceptional:</strong> Tyrannosaurus Rex, Brontosaurus, or Therizinosaurus.</li>
            <li><strong>Extraordinary:</strong> Yutyrannus, Deinonychus, or Wyvern.</li>
          </ul>
        </li>
      </ul>

      <h3>2. The Irrigated Greenhouse Farm</h3>
      <p>
        Four advanced crops are required across kibble recipes: <strong>Rockarrot (Carrots)</strong>, <strong>Savoroot (Potatoes)</strong>, <strong>Longrass (Corn)</strong>, and <strong>Citronal (Lemons)</strong>.
      </p>
      <ul>
        <li>Construct a 3&times;3 greenhouse room using Greenhouse Walls and Ceilings to achieve the maximum <strong>+300% Greenhouse Effect</strong>.</li>
        <li>Use <strong>Large Crop Plots</strong> irrigated by metal or stone intake pipes connected to an infinite ocean or river source.</li>
        <li>Tame 2 to 3 <strong>Dung Beetles</strong> from caves. Fill their inventories with Large/Medium animal feces; every 15 minutes they produce Fertilizer and Oil automatically.</li>
      </ul>
    </div>
  </section>

  <!-- Industrial Cooker vs Cooking Pot -->
  <section class="panel" style="margin-top:2rem">
    <h2 class="with-icon"><Icon name="flame" size={22} /> Industrial Cooker vs. Cooking Pot Benchmark</h2>
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr>
            <th>Feature / Parameter</th>
            <th>Primitive Cooking Pot</th>
            <th>Tek / Industrial Cooker</th>
          </tr>
        </thead>
        <tbody>
          {cookerComparison.map((c) => (
            <tr>
              <td><strong>{c.feature}</strong></td>
              <td>{c.pot}</td>
              <td style="color:var(--amber-300)"><strong>{c.cooker}</strong></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="prose" style="margin-top:2.5rem">
    <h2>The Homestead Kibble Hierarchy</h2>
    <p>
      Prior to the Homestead update (v285.106), ARK required dozens of hyper-specific kibble combinations (e.g., Quetzal eggs only for Dimetrodon).
      The modern system groups eggs into 6 strict size classes. A creature accepts its preferred tier at full 400 affinity,
      the tier above at full 400 affinity, and any inferior tier at 16 affinity per piece.
      Always store cooked kibbles in a Refrigerator where their spoil timer extends to 100 days.
    </p>
  </section>

  <section style="margin-top:2.5rem" aria-label="FAQ">
    <h2>Kibble FAQ</h2>
    {faq.map((f) => (
      <details class="faq">
        <summary>{f.q}</summary>
        <div class="faq-body"><p>{f.a}</p></div>
      </details>
    ))}
  </section>

  <script>
    const input = document.getElementById('kb-search') as HTMLInputElement;
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('#kb-table tbody tr'));
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      for (const row of rows) {
        row.hidden = q.length > 0 && !row.dataset.name!.includes(q);
      }
    });
  </script>
</BaseLayout>
