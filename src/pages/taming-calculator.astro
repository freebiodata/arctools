---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { creatures, CREATURE_COUNT } from '../data/creatures';
import { usableFoods } from '../lib/taming';

const tameable = creatures.filter((c) => c.tameMethod !== 'special');
const special = creatures.filter((c) => c.tameMethod === 'special');
const groups = [...new Set(tameable.map((c) => c.group))];

const faq = [
  {
    q: 'What is taming effectiveness and why does it drop?',
    a: 'Taming effectiveness (TE) starts at 100% when a wild dino is knocked out and degrades each time it feeds. Taking damage while unconscious also permanently slashes TE for that tame. TE decides how many bonus levels you get: Bonus Levels = floor(Wild Level * (TE / 2)). A Level 150 Rex tamed at 98.7% TE gains +74 levels (Level 224); the same Rex tamed on raw meat at 55% TE only gains +41 levels (Level 191). Superior food requires fewer total feedings, resulting in minimal TE degradation.',
  },
  {
    q: 'Does starve taming save food or speed up the tame?',
    a: 'No. Starve taming does not save a single piece of food, does not increase overall taming speed, and does not alter final taming effectiveness. The creature requires the exact same total affinity and must burn the exact same total food points. However, starve taming protects your valuable kibble or raw mutton: by withholding food until the creature\'s hunger has dropped by the required total, you avoid losing food if a wild predator hits the tame or an enemy player disrupts it.',
  },
  {
    q: 'How many narcotics will I need and how should I dose them?',
    a: 'Narcotics replenish torpor lost to natural decay during the tame. Each narcotic adds 40 torpor over 8 seconds, Biotoxin adds 80 over 16 seconds, and narcoberries add 7.5 over 5 seconds. Stacking narcotics queues their duration continuously, freezing natural torpor decay. Apex predators like Giganotosaurus drain hundreds of torpor per second, requiring hundreds of narcotics, whereas slow-drain herbivores like Stegosaurus often require zero narcotics at 1x rates.',
  },
  {
    q: 'What knockout weapon should I use to avoid killing the creature?',
    a: 'Weapons deliver different ratios of torpor to direct damage. The Crossbow deals 35 damage and 157.5 torpor with tranq arrows (Torpor/Damage ratio ~4.5:1), making it cheap but dangerous for fragile tames like Dire Bears, Sabertooths, and Gallimimus. The Longneck Rifle with Standard Tranq Darts deals 26 damage and 221 torpor (Ratio ~8.5:1), making it drastically safer. Shocking Tranq Darts deliver 442 torpor with the same 26 damage (Ratio ~17:1), representing the safest knockout method in ARK.',
  },
  {
    q: 'Why does preferred kibble tame 5x faster than raw meat?',
    a: 'Preferred kibble provides 400 taming affinity per bite compared to 150 for raw prime meat and 50 for raw meat. Furthermore, each kibble satisfies 80 food points, allowing the creature to absorb large affinity increments quickly. Non-preferred kibble (mismatched tier) only yields 16 affinity per piece—significantly worse than raw meat—so always use the exact tier or higher.',
  },
  {
    q: 'What is the 5-second tranq arrow delay rule?',
    a: 'Tranq arrows deliver instant torpor on hit followed by an additional torpor-over-time effect over 4 to 5 seconds. If you fire tranq arrows as fast as possible without spacing shots, the instant torpor applies, but overlapping torpor-over-time ticks do not multiply. Spacing shots roughly 4 to 5 seconds apart maximizes torpor efficiency and minimizes physical damage dealt to the target.',
  },
  {
    q: 'Can I reset a tame if a predator damaged it?',
    a: 'Yes. If a wild raptor, sabertooth, or dilo attacks your unconscious tame, its Taming Effectiveness permanently plummets. To fix this, allow the creature to wake up completely (let torpor drop to 0) without feeding it. Once awake, its health and effectiveness reset; you can immediately knock it out again with pristine 100% taming effectiveness.',
  },
  {
    q: 'What is the official maximum wild dinosaur level?',
    a: 'On official ASE and ASA servers with Difficulty 5.0 (DifficultyOffset=1.0), wild creatures spawn in level increments of 5 up to Level 150 (Tek creatures spawn up to Level 180; Wyverns/Drakes spawn up to Level 190). Our calculator supports custom levels up to 300 for players on unofficial and private servers.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'ARK Taming Calculator',
    applicationCategory: 'GameApplication',
    operatingSystem: 'Web',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description:
      'ARK: Survival Evolved & Ascended taming calculator with exact food counts, taming duration, narcotics, torpor decay, and knockout weapon shots for server rates 1x-50x.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

const weaponsData = [
  { name: 'Shocking Tranq Dart (Longneck)', instantTorpor: '156.0', overTimeTorpor: '286.0', totalTorpor: '442.0', damage: '26.0', ratio: '17.0x', lethalityRisk: 'Ultra Low' },
  { name: 'Tranq Dart (Longneck Rifle)', instantTorpor: '78.0', overTimeTorpor: '143.0', totalTorpor: '221.0', damage: '26.0', ratio: '8.5x', lethalityRisk: 'Low' },
  { name: 'Tranq Spear Bolt (Harpoon)', instantTorpor: '180.0', overTimeTorpor: '120.0', totalTorpor: '300.0', damage: '36.0', ratio: '8.3x', lethalityRisk: 'Low (Underwater)' },
  { name: 'Tranq Arrow (Crossbow)', instantTorpor: '70.0', overTimeTorpor: '87.5', totalTorpor: '157.5', damage: '35.0', ratio: '4.5x', lethalityRisk: 'Moderate' },
  { name: 'Tranq Arrow (Bow - Max Pull)', instantTorpor: '50.0', overTimeTorpor: '62.5', totalTorpor: '112.5', damage: '25.0', ratio: '4.5x', lethalityRisk: 'Moderate' },
  { name: 'Stone Slingshot', instantTorpor: '14.0', overTimeTorpor: '0.0', totalTorpor: '14.0', damage: '14.0', ratio: '1.0x', lethalityRisk: 'High' },
  { name: 'Club (Wooden)', instantTorpor: '10.0', overTimeTorpor: '0.0', totalTorpor: '10.0', damage: '5.0', ratio: '2.0x', lethalityRisk: 'High (Melee)' },
];
---
<BaseLayout
  title="ARK Taming Calculator - Food, Time, Narcotics & Tranqs (1x–50x)"
  description="ARK taming calculator for 60+ popular creatures: exact kibble/meat counts, taming time, effectiveness, bonus levels, narcotics, and knockout weapon shots for any server rate from 1x to 50x."
  path="/taming-calculator/"
  schema={schema}
>
  <section class="page-head">
    <span class="eyebrow"><Icon name="drumstick" size={15} /> Tool 01 - Knockout &amp; Passive Expeditions</span>
    <h1>ARK Taming Calculator</h1>
    <p class="lead">
      Configure your target creature, wild level, server rate, and food choice.
      The engine calculates exact affinity requirements, food stacks, taming duration, taming effectiveness decay,
      post-tame bonus levels, narcotic requirements, and knockout weapon ammunition.
    </p>
    <div class="tag-row">
      <span class="badge">{CREATURE_COUNT} Verified Creatures</span>
      <span class="badge">Rates 1x–50x</span>
      <span class="badge">Knockout Shot Estimates</span>
      <span class="badge">Starve Taming Thresholds</span>
    </div>
  </section>

  <div class="grid-2">
    <form class="panel" id="taming-form" aria-label="Taming calculator inputs">
      <h2 class="with-icon" style="font-size:1.35rem"><Icon name="clipboard-list" size={20} /> Expedition Parameters</h2>

      <div class="field">
        <label for="tc-creature">Creature Species</label>
        <select id="tc-creature">
          {groups.map((g) => (
            <optgroup label={g}>
              {tameable.filter((c) => c.group === g).map((c) => (
                <option value={c.slug} data-slug={c.slug}>
                  {c.name}{c.tameMethod === 'passive' ? ' (passive)' : ''}
                </option>
              ))}
            </optgroup>
          ))}
        </select>
        <p class="muted" id="tc-creature-note" style="font-size:.85rem;margin:.4rem 0 0"></p>
      </div>

      <div class="field">
        <label for="tc-level">
          Wild Level <span class="hint">(Official Difficulty 5 Max: 150)</span>
        </label>
        <input type="range" id="tc-level-range" min="1" max="300" value="150" step="1" />
        <div style="display:flex;gap:.6rem;align-items:center;margin-top:.4rem">
          <input type="number" id="tc-level" min="1" max="300" value="150" style="width:110px" />
          <span class="muted" id="tc-level-warn" style="font-size:.85rem;color:var(--amber-400)" hidden>
            &gt; 150 is unofficial / custom server difficulty
          </span>
        </div>
      </div>

      <div class="field">
        <label for="tc-food">Food Selection</label>
        <select id="tc-food"></select>
        <p class="muted" id="tc-food-note" style="font-size:.85rem;margin:.4rem 0 0"></p>
      </div>

      <div class="field">
        <label>Server Taming Rate Multiplier</label>
        <div class="seg" id="tc-rates" role="group" aria-label="Quick server rate presets">
          <button type="button" data-rate="1" aria-pressed="true">1x (Official)</button>
          <button type="button" data-rate="2">2x</button>
          <button type="button" data-rate="3">3x (Weekend)</button>
          <button type="button" data-rate="5">5x</button>
          <button type="button" data-rate="10">10x</button>
        </div>
        <div style="margin-top:.6rem;display:flex;gap:.6rem;align-items:center">
          <input type="number" id="tc-custom-rate" min="0.1" max="50" step="0.1" placeholder="Custom (e.g. 2.5)" style="max-width:160px" />
          <span class="muted" style="font-size:.85rem">or type custom rate</span>
        </div>
      </div>

      <div class="callout" id="tc-passive-note" hidden>
        <strong>Passive Tame:</strong> Do not knock this creature out. Equip the preferred food in the
        far-right slot (slot 0) of your hotbar, approach from behind (crouched or wearing Ghillie), and press use when prompted.
      </div>
    </form>

    <div class="results" aria-live="polite">
      <section class="panel" aria-label="Taming requirements">
        <h2 class="with-icon" style="font-size:1.35rem"><Icon name="hourglass" size={20} /> Taming Projections</h2>
        <div class="stat-grid">
          <div class="stat"><span class="stat__label"><Icon name="drumstick" size={13} /> Food required</span><span class="stat__value" id="tc-food-count">–</span><span class="stat__sub" id="tc-food-detail"></span></div>
          <div class="stat"><span class="stat__label"><Icon name="clock" size={13} /> Taming duration</span><span class="stat__value" id="tc-time">–</span><span class="stat__sub" id="tc-feedings"></span></div>
          <div class="stat"><span class="stat__label"><Icon name="percent" size={13} /> Effectiveness</span><span class="stat__value" id="tc-te">–</span><span class="stat__sub">starting at 100%</span></div>
          <div class="stat"><span class="stat__label"><Icon name="trending-up" size={13} /> Post-tame level</span><span class="stat__value" id="tc-level-after">–</span><span class="stat__sub" id="tc-level-bonus"></span></div>
          <div class="stat"><span class="stat__label"><Icon name="pill" size={13} /> Narcotics needed</span><span class="stat__value" id="tc-narcotics">–</span><span class="stat__sub" id="tc-narcotics-sub"></span></div>
          <div class="stat"><span class="stat__label"><Icon name="leaf" size={13} /> Biotoxin / berries</span><span class="stat__value" id="tc-biotoxin">–</span><span class="stat__sub" id="tc-berries"></span></div>
        </div>
        <div class="table-wrap" style="margin-top: .9rem">
          <table class="data" id="tc-tranq-table">
            <thead>
              <tr><th><Icon name="crosshair" size={13} /> Knockout weapon</th><th class="num">Torpor / hit</th><th class="num">Hits (body)</th><th class="num">Hits (head)</th></tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
        <p class="muted" style="font-size:.82rem;margin:.6rem 0 0">
          Headshots multiply tranq weapon torpor ×2.5 on most creatures. Bring ~15% extra
          ammunition for misses and torpor decay during the knockout.
        </p>
      </section>

      <section class="panel" aria-label="Food comparison">
        <h2 class="with-icon" style="font-size:1.2rem"><Icon name="utensils" size={19} /> All Foods Compared <span class="muted" style="text-transform:none;font-family:var(--font-body);font-size:.85rem">(Same Level &amp; Rate)</span></h2>
        <div class="table-wrap">
          <table class="data" id="tc-compare-table">
            <thead>
              <tr><th>Food</th><th class="num">Amount</th><th class="num">Time</th><th class="num">TE</th><th class="num">Post-tame lvl</th><th class="num">Narcotics</th></tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </section>
    </div>
  </div>

  <!-- Knockout Weapons Efficiency Guide -->
  <section class="panel" style="margin-top: 2rem" aria-label="Knockout Weapons Guide">
    <h2 class="with-icon"><Icon name="crosshair" size={22} /> Knockout Weapon Efficiency &amp; Lethality Benchmark</h2>
    <p>
      Knocking out a wild creature requires balancing torpor delivery against incoming physical damage.
      Fragile creatures with small health pools (Dire Bear, Sabertooth, Gallimimus, Otter) will frequently die
      if shot with weapons having a low Torpor-to-Damage ratio:
    </p>
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr>
            <th>Knockout Weapon &amp; Ammo</th>
            <th class="num">Instant Torpor</th>
            <th class="num">Over-Time Torpor</th>
            <th class="num">Total Torpor</th>
            <th class="num">Base Damage</th>
            <th class="num">Torpor / Damage</th>
            <th>Lethality Risk</th>
          </tr>
        </thead>
        <tbody>
          {weaponsData.map((w) => (
            <tr>
              <td><strong>{w.name}</strong></td>
              <td class="num">{w.instantTorpor}</td>
              <td class="num">{w.overTimeTorpor}</td>
              <td class="num">{w.totalTorpor}</td>
              <td class="num">{w.damage}</td>
              <td class="num"><strong>{w.ratio}</strong></td>
              <td><span class={`badge ${w.lethalityRisk.includes('Low') ? 'badge--pass' : 'badge--warn'}`}>{w.lethalityRisk}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="callout" style="margin-top: 1rem">
      <strong>Pro Tip — The 5-Second Delay Rule:</strong> Tranq arrows and tranq darts deal torpor over a 4 to 5 second duration.
      Firing tranq arrows in rapid succession without waiting resets the over-time torpor buff rather than stacking it additively.
      Always pace your shots 4.5 seconds apart when taking down dangerous tames to save ammunition and prevent accidental kills.
    </div>
  </section>

  <!-- Starve Taming Guide -->
  <section class="panel" style="margin-top: 2rem">
    <h2 class="with-icon"><Icon name="shield" size={22} /> Starve Taming: Facts, Myths &amp; Step-by-Step Execution</h2>
    <div class="prose">
      <p>
        <strong>What Starve Taming Does:</strong> Starve taming is the practice of leaving an unconscious creature without any food in its inventory
        until its hunger value has dropped by an amount equal to the total food requirement of the tame.
      </p>
      <p>
        <strong>The Myth:</strong> Many survivors mistakenly believe starve taming saves kibble, increases final taming effectiveness, or speeds up the clock.
        <em>It does none of these.</em> The creature requires the exact same total affinity points and must starve by the exact same amount of hunger whether it feeds
        incrementally or all at once.
      </p>
      <p>
        <strong>The Real Benefit (Risk Mitigation):</strong>
      </p>
      <ul>
        <li><strong>Protection Against Wild Predators:</strong> If a wandering Carno, Raptor, or Dilo bites your unconscious Rex midway through a normal tame,
        its Taming Effectiveness is permanently ruined, and any kibble already consumed is wasted. With starve taming, zero food has been consumed; you can let the creature wake up, reset its health and TE to 100%, and knock it out again.</li>
        <li><strong>Protection Against Enemy Tribes (PvP):</strong> If enemy players raid your taming pen while you are starving the dino, they get zero kibble or mutton from its inventory.</li>
        <li><strong>Food Spoilage Preservation:</strong> Raw Mutton and Raw Prime Meat spoil in under 20 minutes in a dino's inventory. By keeping food in a Preserving Bin or refrigerator until the dino is fully starved, your prime food never spoils on the beach.</li>
      </ul>
      <p>
        <strong>How to Calculate Starve Target:</strong>
        <code>Hunger Deficit Required = Total Food Items &times; Food Restored Per Item</code>
        <br />
        <em>Example:</em> A tame requiring 15 Exceptional Kibble (restoring 80 food each) requires the dino's food to drop by <code>15 &times; 80 = 1,200 points</code>.
        Once its food stat is 1,200 below max, place all 15 kibble in its inventory at once. It will consume them back-to-back in seconds, finishing the tame immediately!
      </p>
    </div>
  </section>

  <section class="panel" style="margin-top:1.5rem">
    <h2 class="with-icon"><Icon name="triangle-alert" size={20} /> Special-Mechanic Tames (Not in Standard Calculator)</h2>
    <div class="table-wrap">
      <table class="data">
        <thead><tr><th>Creature</th><th>Mechanic</th></tr></thead>
        <tbody>
          {special.map((c) => (
            <tr><td><strong>{c.name}</strong></td><td style="white-space:normal">{c.note}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="prose" style="margin-top:2.5rem">
    <h2>How ARK Taming Math Works Under the Hood</h2>
    <p>
      Every creature requires a target amount of <strong>taming affinity</strong> that scales
      with wild level: <code>Affinity Required = BaseAffinity + (LevelAffinity &times; WildLevel)</code>.
      Each food item provides affinity based on the species' affinity table (preferred kibble is
      400 affinity, raw prime 150, raw meat 50), scaled by your server's taming rate multiplier.
      The required item count is calculated as <code>ceil(Affinity Required / (AffinityPerFood &times; ServerRate))</code>.
    </p>
    <p>
      Taming duration is governed by the species' food consumption rate. A knocked-out creature only eats once its food stat
      drops by the exact food value of the selected item. High-tier foods restore more hunger per bite, allowing the tame
      to finish with far fewer feedings and significantly less effectiveness decay.
    </p>
    <p>
      Taming effectiveness decays per feeding according to:
      <code>TE = 1 / (1 + (Ineffectiveness &times; Feedings / AffinityPerFeeding))</code>.
      Bonus wild levels awarded upon completion equal:
      <code>floor(WildLevel &times; TE / 2)</code>.
    </p>
  </section>

  <section style="margin-top:2.5rem" aria-label="FAQ">
    <h2>Taming FAQ</h2>
    {faq.map((f) => (
      <details class="faq">
        <summary>{f.q}</summary>
        <div class="faq-body"><p>{f.a}</p></div>
      </details>
    ))}
  </section>

  <script>
    import { creatures } from '../data/creatures';
    import {
      computeTaming,
      usableFoods,
      getFoodValues,
      formatDuration,
      torporAtLevel,
      DEFAULT_SERVER,
      type ServerSettings,
    } from '../lib/taming';
    import type { Creature } from '../data/types';

    const tameable = creatures.filter((c) => c.tameMethod !== 'special');
    const bySlug = new Map(tameable.map((c) => [c.slug, c]));

    const el = <T extends HTMLElement>(id: string): T => document.getElementById(id) as T;
    const selCreature = el<HTMLSelectElement>('tc-creature');
    const inpLevel = el<HTMLInputElement>('tc-level');
    const rangeLevel = el<HTMLInputElement>('tc-level-range');
    const selFood = el<HTMLSelectElement>('tc-food');
    const foodNote = el<HTMLParagraphElement>('tc-food-note');
    const creatureNote = el<HTMLParagraphElement>('tc-creature-note');
    const rateWrap = el<HTMLDivElement>('tc-rates');
    const customRate = el<HTMLInputElement>('tc-custom-rate');

    const state = {
      slug: 'rex',
      level: 150,
      food: 'Exceptional Kibble',
      rate: 1,
    };

    function creature(): Creature {
      return bySlug.get(state.slug) ?? tameable[0];
    }

    function rebuildFoods() {
      const c = creature();
      const foods = usableFoods(c);
      selFood.innerHTML = '';
      for (const f of foods) {
        const opt = document.createElement('option');
        opt.value = f;
        opt.textContent = f;
        if (f === `${c.preferredKibble} Kibble`) {
          opt.textContent = `★ ${f} (preferred)`;
        }
        selFood.appendChild(opt);
      }
      const preferred = c.preferredKibble ? `${c.preferredKibble} Kibble` : foods[0];
      state.food = foods.includes(preferred) ? preferred : foods[0];
      selFood.value = state.food;

      creatureNote.textContent = `${c.name} · ${c.group} · Base torpor ${c.baseTorpor.toLocaleString('en-US')}${
        c.tameMethod === 'passive' ? ' · Passive tame' : ''
      }`;
      const fv = getFoodValues(c, state.food);
      foodNote.textContent = fv && (fv.q ?? 1) > 1
        ? `Eats ${fv.q} at a time - plan ${fv.q}× the stack size`
        : c.preferredKibble
          ? `Preferred kibble tier: ${c.preferredKibble}`
          : '';
    }

    const fmtInt = (n: number) => Math.round(n).toLocaleString('en-US');

    function render() {
      const c = creature();
      const server: ServerSettings = { ...DEFAULT_SERVER, tamingSpeedMultiplier: state.rate };
      const r = computeTaming(c, state.level, state.food, server);
      const isPassive = c.tameMethod === 'passive';

      if (!r) {
        el('tc-food-count').textContent = '–';
        el('tc-food-detail').textContent = 'Cannot tame with this food';
        el('tc-time').textContent = '–';
        el('tc-feedings').textContent = '';
        el('tc-te').textContent = '–';
        el('tc-level-after').textContent = '–';
        el('tc-level-bonus').textContent = '';
        el('tc-narcotics').textContent = '–';
        el('tc-narcotics-sub').textContent = '';
        el('tc-biotoxin').textContent = '–';
        el('tc-berries').textContent = '';
        return;
      }

      el('tc-food-count').textContent = fmtInt(r.itemsTotal);
      el('tc-food-detail').textContent = `${r.feedings} feedings · ${r.itemsEach} per bite`;
      el('tc-time').textContent = formatDuration(r.seconds);
      el('tc-feedings').textContent = `every ~${formatDuration(r.secondsPerFeeding)}`;
      el('tc-te').textContent = `${(r.tamingEffectiveness * 100).toFixed(1)}%`;
      el('tc-level-after').textContent = String(r.levelAfterTame);
      el('tc-level-bonus').textContent = `+${r.bonusLevels} levels (perfect: +${r.maxBonusLevels})`;

      if (isPassive) {
        el('tc-narcotics').textContent = 'None';
        el('tc-narcotics-sub').textContent = 'Passive tame';
        el('tc-biotoxin').textContent = 'None';
        el('tc-berries').textContent = 'Passive tame';
      } else {
        el('tc-narcotics').textContent = fmtInt(r.narcotics);
        el('tc-narcotics-sub').textContent = r.narcotics === 0 ? 'Stays down naturally' : 'To hold torpor';
        el('tc-biotoxin').textContent = fmtInt(r.biotoxin);
        el('tc-berries').textContent = `or ${fmtInt(r.narcoberries)} narcoberries`;
      }

      // tranq table
      const tb = el('tc-tranq-table').querySelector('tbody')!;
      if (isPassive) {
        tb.innerHTML = '<tr><td colspan="4" class="muted">Passive tame - do not tranq.</td></tr>';
      } else {
        const weapons = [
          { name: 'Shocking Tranq Dart', torpor: 442 },
          { name: 'Tranq Dart (Longneck)', torpor: 221 },
          { name: 'Tranq Arrow (Crossbow)', torpor: 157.5 },
          { name: 'Tranq Arrow (Bow)', torpor: 112.5 },
          { name: 'Slingshot (Stone)', torpor: 14 },
          { name: 'Wooden Club', torpor: 10 },
        ];
        tb.innerHTML = weapons.map(({ name, torpor }) => {
          const body = Math.ceil(r.torporTotal / torpor);
          const head = Math.ceil(r.torporTotal / (torpor * 2.5));
          return `<tr><td>${name}</td><td class="num">${fmtInt(torpor)}</td><td class="num">${fmtInt(body)}</td><td class="num">${fmtInt(head)}</td></tr>`;
        }).join('');
      }

      // compare table
      const cmp = el('tc-compare-table').querySelector('tbody')!;
      const starSvg = `<svg class="icon" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="color:var(--amber-400)" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`;
      const rows = usableFoods(c)
        .map((name) => ({ name, r: computeTaming(c, state.level, name, server) }))
        .filter((x) => x.r)
        .sort((a, b) => a.r!.seconds - b.r!.seconds)
        .slice(0, 12);
      cmp.innerHTML = rows.map(({ name, r: v }) => {
        const amt = v!.itemsEach > 1 ? `${fmtInt(v!.itemsTotal)} (${v!.feedings}×${v!.itemsEach})` : fmtInt(v!.itemsTotal);
        const star = name === `${c.preferredKibble} Kibble` ? `${starSvg} ` : '';
        return `<tr><td>${star}${name}</td><td class="num">${amt}</td><td class="num">${formatDuration(v!.seconds)}</td><td class="num">${(v!.tamingEffectiveness * 100).toFixed(1)}%</td><td class="num">${v!.levelAfterTame}</td><td class="num">${fmtInt(v!.narcotics)}</td></tr>`;
      }).join('');

      el('tc-passive-note').hidden = !isPassive;
      el('tc-level-warn').hidden = state.level <= 150;
    }

    // wire events
    selCreature.addEventListener('change', () => {
      state.slug = selCreature.value;
      rebuildFoods();
      render();
    });
    function setLevel(v: number) {
      state.level = Math.min(300, Math.max(1, Math.round(v) || 1));
      inpLevel.value = String(state.level);
      rangeLevel.value = String(state.level);
      render();
    }
    inpLevel.addEventListener('input', () => setLevel(Number(inpLevel.value)));
    rangeLevel.addEventListener('input', () => setLevel(Number(rangeLevel.value)));
    selFood.addEventListener('change', () => {
      state.food = selFood.value;
      const fv = getFoodValues(creature(), state.food);
      foodNote.textContent = fv && (fv.q ?? 1) > 1
        ? `Eats ${fv.q} at a time - plan ${fv.q}× the stack size`
        : creature().preferredKibble
          ? `Preferred kibble tier: ${creature().preferredKibble}`
          : '';
      render();
    });
    rateWrap.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;
      state.rate = Number(btn.dataset.rate);
      customRate.value = '';
      rateWrap.querySelectorAll('button').forEach((b) =>
        b.setAttribute('aria-pressed', String(Number((b as HTMLButtonElement).dataset.rate) === state.rate)),
      );
      render();
    });
    customRate.addEventListener('input', () => {
      const v = Number(customRate.value);
      if (v > 0) {
        state.rate = v;
        rateWrap.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', 'false'));
        render();
      }
    });

    // init: default Rex from URL params if present
    const params = new URLSearchParams(location.search);
    const slugParam = params.get('creature');
    if (slugParam && bySlug.has(slugParam)) {
      state.slug = slugParam;
    }
    selCreature.value = state.slug;
    const lvlParam = Number(params.get('level'));
    rebuildFoods();
    setLevel(Number.isFinite(lvlParam) && lvlParam > 0 ? Math.min(300, lvlParam) : 150);
  </script>
</BaseLayout>
